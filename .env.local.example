NEXT_PUBLIC_SUPABASE_URL=https://mise-gastro.de
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_FROM_supabase_status
SUPABASE_SERVICE_ROLE_KEY=REPLACE_FROM_supabase_status
ELEVENLABS_WEBHOOK_SECRET=

# Neo → Mise OS: serverseitiges SSO. Derselbe Wert muss im Mise-OS-Backend
# als SSO_SECRET gesetzt sein und darf niemals NEXT_PUBLIC_ heißen.
MISE_OS_SSO_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MISE_OS_APP_URL=https://mise-os-theta.vercel.app
MISE_OS_API_URL=https://mise-gastro.de/api/v1
