# Explicit opt-in for local KDS demos. Keep false in every real environment.
NEXT_PUBLIC_ENABLE_KDS_MOCKS=false

# Optional manual driver diagnostics. Never commit real credentials.
MISE_TEST_DRIVER_EMAIL=
MISE_TEST_DRIVER_EMAILS=
MISE_TEST_DRIVER_PASSWORD=
MISE_TEST_DRIVER_ID=
MISE_E2E_OUTPUT_DIR=test-results/manual-driver
ELEVENLABS_WEBHOOK_SECRET=
